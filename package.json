{
  "name": "signal-arena",
  "private": true,
  "version": "1.0.0",
  "description": "Patch real, keyless AI models into a four-game arcade suite and spectate them compete.",
  "author": "Nortaq-PlayNexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nortaq-PlayNexus/signal-arena.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:pack": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.nortaq.signalarena",
    "productName": "Signal Arena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^9.5.1"
  }
}
